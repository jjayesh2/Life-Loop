# Life-Loop Environment Configuration

# Server Host and Port
PORT=8000
HOST=127.0.0.1

# Database Configuration
DATABASE_URL=sqlite:///./lifeloop.db

# Mappls Vector Maps / Zero-Credential Leaflet Fallback
# If MAPPLS_API_KEY is provided, vector tiles can be activated.
# Otherwise, OpenStreetMap tiles serve as the reliable zero-credential fallback.
VITE_MAPPLS_API_KEY=

# Audio & Speech Synthesis Defaults
VITE_ENABLE_SOUND=true
VITE_ENABLE_VOICE=true

# Solver Settings
MILP_SOLVER_NAME=highs
