# ==============================================================================
# LIFE-LOOP PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (backend) or .env.local (frontend) and configure values.
# NEVER commit sensitive API keys or real database passwords to version control.

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE & DATABASE CONFIGURATION (FastAPI)
# ------------------------------------------------------------------------------
# Server port and host (default 8000 on localhost)
PORT=8000
HOST=0.0.0.0

# Database Connection URL:
# - Local Development: sqlite:///./lifeloop.db
# - Production (PostgreSQL / Neon / Supabase): postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./lifeloop.db

# Mixed-Integer Linear Programming (MILP) Solver
# Supported options: 'highs' (Scipy MILP default engine - built-in zero-credential)
MILP_SOLVER_NAME=highs

# ------------------------------------------------------------------------------
# 2. FRONTEND VERCEL ENVIRONMENT CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# URL of the deployed FastAPI backend API:
# - If frontend and backend are hosted separately (e.g. Frontend on Vercel, Backend on Render/Railway/Fly.io):
#   Set this to your backend's public URL: https://your-backend-service.onrender.com
# - If left empty or omitted, frontend defaults to relative '/api' calls (via proxy or rewrite)
VITE_API_URL=

# Mappls Vector Maps (Optional external integration)
# - If provided: activates high-resolution vector base maps
# - If omitted (Default): Life-Loop automatically activates the built-in Leaflet + OpenStreetMap engine with zero external API key requirements
VITE_MAPPLS_API_KEY=

# Audio Effects & Web Speech Dispatch Telemetry
# Controls synthetic voice dispatch alerts and sound chimes
VITE_ENABLE_SOUND=true
VITE_ENABLE_VOICE=true
